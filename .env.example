# Hestian environment configuration.
#
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
#
# Never commit `.env.local`, `.env.production` or any file containing real
# credentials. See docs/SECURITY.md.

# Deployment environment label. Values: local | preview | production
HESTIAN_ENV=local

# Minimum structured log level. Values: debug | info | warn | error
LOG_LEVEL=info

# NOTE: Milestone 0 introduces no secrets and no database. When the financial
# core is implemented, credentials are supplied as server-side bindings and are
# never exposed through NEXT_PUBLIC_* variables.
