{
  "name": "hestian",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hestian AI - a business operating system for creator-led businesses.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/ensure-dev-vars.mjs",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "preview:worker": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "start:worker": "wrangler dev --ip 127.0.0.1 --port 8787",
    "deploy:worker": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "check:boundaries": "vitest run tests/architecture",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "verify:dev": "node scripts/verify-dev-preview.mjs",
    "auth:schema": "tsx scripts/generate-auth-schema.ts",
    "sbom": "npm sbom --omit=dev --sbom-format=cyclonedx > docs/sbom.production.cdx.json"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.17",
    "better-auth": "1.7.22",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@better-auth/utils": "0.5.1",
    "@next/eslint-plugin-next": "16.4.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "jose": "6.2.17",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0",
    "wrangler": "4.161.0"
  },
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.3"
  }
}
