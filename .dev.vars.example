# Local development variables for `next dev`, `wrangler dev` and
# `opennextjs-cloudflare preview`.
#
# `npm run dev` creates this file automatically from this example if it is
# missing, replacing only the placeholder with a random development secret.
# The file is git-ignored and no real credential is ever committed; production
# values are supplied as platform secret bindings.
#
# Values are read when the dev server starts. Restart it after editing them.
NEXTJS_ENV=development

# 32+ character secret used to sign sessions and tokens. Generate locally with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=development-only-replace-with-32-plus-random-characters

# Public origin used for callback and CSRF origin checks by the local Worker.
# `next dev` derives a loopback origin from the actual request instead, so a
# preview assigned a different port does not fail CSRF checks. Non-loopback
# origins are ignored, and production always uses the configured binding.
BETTER_AUTH_URL=http://127.0.0.1:8787

# Local development keeps unverified sign-in off so an account is usable without
# a mail provider. Production defaults to REQUIRED unless set to "false"; a
# production build without email credentials therefore fails closed.
EMAIL_VERIFICATION_REQUIRED=false

# Email delivery (Resend HTTP API). Leave blank locally; set as platform secret
# bindings in preview/production. Without both values the mailer reports
# "unconfigured" and sends nothing.
# RESEND_API_KEY=
# EMAIL_FROM=Hestian <no-reply@example.com>
