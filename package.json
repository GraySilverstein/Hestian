{
  "name": "hestian",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hestian AI - a business operating system for creator-led businesses.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
